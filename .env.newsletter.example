# Copy these settings into .env.local and the Vercel project environment.
# Credentials must never be committed. Keep disabled until setup is complete.
NEWSLETTER_ENABLED=false
RESEND_API_KEY=
RESEND_SEGMENT_ID=
NEWSLETTER_FROM=
NEWSLETTER_CONTACT_EMAIL=
NEWSLETTER_OWNER=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CRON_SECRET=

# always: show to every visitor during validation; first-visit: show once per browser.
# off: no automatic prompt; the newsletter section remains available.
NEXT_PUBLIC_NEWSLETTER_PROMPT_MODE=always
