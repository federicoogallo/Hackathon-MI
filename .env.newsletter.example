# Add these values privately in .env.local and Vercel Production settings.
# Keep disabled until Brevo Free, a verified sender and Upstash Free are ready.
NEWSLETTER_ENABLED=false
BREVO_API_KEY=
BREVO_LIST_ID=
# Real email address verified in Brevo, without a display name or angle brackets.
# hackathon-milano.vercel.app is the website, not a usable email sender domain.
NEWSLETTER_FROM=
NEWSLETTER_CONTACT_EMAIL=
NEWSLETTER_OWNER=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CRON_SECRET=

# All website links use this origin. It does not create an email mailbox.
NEXT_PUBLIC_SITE_URL=https://hackathon-milano.vercel.app

# always: prompt every visit; first-visit: once per browser; off: manual signup only.
NEXT_PUBLIC_NEWSLETTER_PROMPT_MODE=always
