# ─── API Keys ──────────────────────────────────────────────────────────────
# Eventbrite: https://www.eventbrite.com/platform/ → crea app → copia API key
EVENTBRITE_API_KEY=

# Groq (LLM filter): https://console.groq.com → API Keys → Create (gratuito)
GROQ_API_KEY=
# Il modello primario predefinito è openai/gpt-oss-120b. Per sovrascriverlo,
# imposta LLM_MODEL a un model ID Groq supportato (non llama-3.3-70b-versatile).
# Fallback se il modello principale non è disponibile (separati da virgola).
LLM_MODEL_FALLBACKS=qwen/qwen3.6-27b

# Reddit: https://www.reddit.com/prefs/apps → crea "script" app → copia client_id e secret
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Telegram: parla con @BotFather su Telegram → /newbot → copia token
# Per il CHAT_ID: parla con @userinfobot o manda un messaggio al bot e chiama
# https://api.telegram.org/bot<TOKEN>/getUpdates per trovare il tuo chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Repository GitHub usato per generare link "Apri issue" nella UI statica
GITHUB_REPO_URL=https://github.com/federicoogallo/Hackathon-MI

# Meetup (opzionale): https://www.meetup.com/api/ → OAuth consumer
# Se non impostato, il collector usa solo HTML scraping
MEETUP_API_KEY=

# --- Sito web (Next.js su Vercel) ---
# L'interfaccia pubblica usa Next.js e asset locali, senza chiavi client.
# Per il riepilogo email, vedi .env.newsletter.example e docs/newsletter.md.

# Host canonico del sito (senza slash finale). Usato anche dal bot Telegram
# per il pulsante che apre il calendario pubblico.
# Da impostare anche su Vercel (Settings -> Environment Variables) quando si
# passa a un dominio custom. Su GitHub Actions usare la variabile omonima.
NEXT_PUBLIC_SITE_URL=https://hackathon-milano.vercel.app

# Enable only after Web Analytics is enabled on a free Vercel Hobby team.
# No custom events or paid Analytics upgrades are used.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
